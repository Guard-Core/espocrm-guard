<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="bootstrap.php"
    defaultTestSuite="unit"
    cacheDirectory=".phpunit.cache"
    colors="true"
    failOnWarning="true"
    failOnRisky="true"
>
  <testsuites>
