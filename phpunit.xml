      <directory>tests/unit</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>src/files/custom/Espo/Modules/GuardCore</directory>
      <directory>src/scripts</directory>
    </include>
  </source>
</phpunit>
