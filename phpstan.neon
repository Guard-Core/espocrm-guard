parameters:
    level: 8
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false
    paths:
        - src/files/custom
        - src/scripts
    excludePaths:
        - src/files/custom/Espo/Modules/*/vendor
    reportUnmatchedIgnoredErrors: false
    scanDirectories:
        - site/application
        - site/vendor
        - site/custom/Espo/Modules/GuardCore/vendor
